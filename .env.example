# Rugby Campus sentence search. Copy these into Vercel > Project > Settings > Environment Variables.
# NEVER commit real values. NEVER prefix any of these with VITE_ (that would publish them in the browser).
# Leave SEARCH_MODEL unset. If an old SEARCH_MODEL is sitting in Vercel from the first setup, delete it so the default applies.

# --- Model. Default (set in code, nothing to configure): Gemini 3.1 Flash-Lite, $0.25 in / $1.50 out per million tokens, about US$0.0005 per search (roughly 19,000 searches for US$10).
GEMINI_API_KEY=
# SEARCH_PROVIDER=gemini            # or: openai (then set OPENAI_API_KEY; default model gpt-4o-mini)
# OPENAI_API_KEY=
# SEARCH_PRICE_IN_PER_M=0.25        # only if you override the model in code; defaults match the built-in model
# SEARCH_PRICE_OUT_PER_M=1.50

# --- Hard spend cap + rate limits (REQUIRED for AI search: the counters must be persistent)
UPSTASH_REDIS_REST_URL=             # or KV_REST_API_URL / KV_REST_API_TOKEN (Vercel Marketplace > Upstash Redis)
UPSTASH_REDIS_REST_TOKEN=
SEARCH_HASH_SALT=                   # any long random string; used to hash IPs
# SEARCH_MONTHLY_CAP_USD=10
# SEARCH_LIMIT_PER_HOUR=10          # per visitor cookie
# SEARCH_LIMIT_PER_HOUR_IP=30       # per hashed IP (higher so a school wifi network is not blocked)

# --- Anonymous search log + shortlist emails: console (Vercel logs) by default
# SEARCH_LOG_SINK=console           # console | supabase | off
# SHORTLIST_SINK=console            # console | supabase
# SUPABASE_URL=                     # only for the supabase sinks (after supabase/search-migration.sql has been run)
# SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: actually email the shortlist (without these the form just says "saved")
# RESEND_API_KEY=
# SHORTLIST_FROM="Rugby Campus <shortlist@yourdomain>"
# SITE_URL=https://www.example.com

# --- Dev/test only
# SEARCH_MOCK=1                     # use the built-in rule-based parser (no key, no cost)
# SEARCH_ALLOW_MEMORY_STORE=true    # in-memory counters (NOT safe in production: no real cap)
